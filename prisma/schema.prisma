generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Parent {
  id                          Int                   @id @default(autoincrement())
  name                        String
  phoneNumber                 String                @unique @map("phone_number")
  email                       String                @unique
  preferredLanguage           SupportedLanguage?    @default(ENGLISH) @map("preferred_language")
  location                    String
  knownAutismHistory          String?               @map("known_autism_history")
  preferredCommunicationStyle CommunicationStyle?   @default(SIMPLE) @map("preferred_communication_style")
  hashedPassword              String                @map("hashed_password")
  emailVerified               Boolean               @default(false) @map("email_verified")
  createdAt                   DateTime              @default(now()) @map("created_at")
  updatedAt                   DateTime              @updatedAt @map("updated_at")
  autismBehaviourForms        AutismBehaviourForm[]
  children                    Child[]
  childRoutines               ChildRoutine[]
  forumPosts                  CommunityPost[]
  comments                    PostComment[]
  refreshTokens               RefreshToken[]
  votes                       Vote[]

  @@index([email])
  @@map("parents")
}

model Child {
  id                   Int                     @id @default(autoincrement())
  name                 String
  dob                  DateTime
  gender               Gender
  knownDiagnosis       DiagnosisTypes?         @map("known_diagnosis")
  diagnosisStage       DiagnosisStages?        @map("diagnosis_stage")
  developmentalStage   ChildDevelopmentStages? @map("developmental_stage")
  dominantHand         String?                 @map("dominant_hand")
  parentId             Int                     @map("parent_id")
  relationWithParent   ParentChildRelations?   @map("relation_with_parent")
  needsVector          Float[]                 @default([]) @map("needs_vector")
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")
  autismBehaviourForms AutismBehaviourForm[]
  routines             ChildRoutine[]
  routineCheckIns      RoutineCheckIn[]
  parent               Parent                  @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@index([parentId])
  @@map("children")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @map("token_hash")
  parentId  Int      @map("parent_id")
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  parent    Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@index([parentId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model AutismCategory {
  id              Int                            @id @default(autoincrement())
  name            String
  createdAt       DateTime                       @default(now()) @map("created_at")
  updatedAt       DateTime                       @updatedAt @map("updated_at")
  questions       AutismBehaviourQuestionnaire[]
  categoryOutputs AutismCategoryOutput[]

  @@map("autism_categories")
}

model AutismBehaviourQuestionnaire {
  id                Int                               @id @default(autoincrement())
  question          String
  categoryId        Int                               @map("category_id")
  weight            Int
  order             Int
  createdAt         DateTime                          @default(now()) @map("created_at")
  updatedAt         DateTime                          @updatedAt @map("updated_at")
  tags              String[]                          @default([])
  questionResponses AutismBehaviourQuestionResponse[]
  category          AutismCategory                    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("autism_behaviour_questionnaires")
}

model AutismBehaviourForm {
  id                Int                               @id @default(autoincrement())
  parentId          Int                               @map("parent_id")
  childId           Int                               @map("child_id")
  createdAt         DateTime                          @default(now()) @map("created_at")
  updatedAt         DateTime                          @updatedAt @map("updated_at")
  child             Child                             @relation(fields: [childId], references: [id], onDelete: Cascade)
  parent            Parent                            @relation(fields: [parentId], references: [id], onDelete: Cascade)
  questionResponses AutismBehaviourQuestionResponse[]
  categoryOutputs   AutismCategoryOutput[]

  @@index([parentId])
  @@index([childId])
  @@map("autism_behaviour_forms")
}

model AutismBehaviourQuestionResponse {
  id             Int                          @id @default(autoincrement())
  questionId     Int                          @map("question_id")
  parentResponse Int                          @map("parent_response")
  formId         Int                          @map("form_id")
  createdAt      DateTime                     @default(now()) @map("created_at")
  updatedAt      DateTime                     @updatedAt @map("updated_at")
  form           AutismBehaviourForm          @relation(fields: [formId], references: [id], onDelete: Cascade)
  question       AutismBehaviourQuestionnaire @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([formId, questionId])
  @@index([formId])
  @@index([questionId])
  @@map("autism_behaviour_question_responses")
}

model AutismCategoryOutput {
  id               Int                 @id @default(autoincrement())
  formId           Int                 @map("form_id")
  categoryId       Int                 @map("category_id")
  totalScore       Int                 @map("total_score")
  maxPossibleScore Int                 @map("max_possible_score")
  normalizedScore  Float               @map("normalized_score")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  category         AutismCategory      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  form             AutismBehaviourForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([formId, categoryId])
  @@index([categoryId])
  @@map("autism_category_outputs")
}

model CommunityPost {
  id        Int           @id @default(autoincrement())
  title     String
  content   String
  authorId  Int           @map("author_id")
  isActive  Boolean       @default(true) @map("is_active")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  author    Parent        @relation(fields: [authorId], references: [id])
  comments  PostComment[]
  votes     Vote[]

  @@index([authorId])
  @@index([id, createdAt])
  @@map("community_posts")
}

model PostComment {
  id              Int           @id @default(autoincrement())
  content         String
  authorId        Int           @map("author_id")
  postId          Int           @map("post_id")
  parentCommentId Int?          @map("parent_comment_id")
  isActive        Boolean       @default(true) @map("is_active")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  author          Parent        @relation(fields: [authorId], references: [id])
  parent          PostComment?  @relation("NestedComments", fields: [parentCommentId], references: [id])
  replies         PostComment[] @relation("NestedComments")
  post            CommunityPost @relation(fields: [postId], references: [id])
  votes           Vote[]

  @@index([postId])
  @@index([parentCommentId])
  @@map("post_comments")
}

model Vote {
  id        Int            @id @default(autoincrement())
  type      VoteType
  parentId  Int            @map("parent_id")
  postId    Int?           @map("post_id")
  commentId Int?           @map("comment_id")
  createdAt DateTime       @default(now()) @map("created_at")
  comment   PostComment?   @relation(fields: [commentId], references: [id])
  parent    Parent         @relation(fields: [parentId], references: [id])
  post      CommunityPost? @relation(fields: [postId], references: [id])

  @@unique([parentId, postId])
  @@unique([parentId, commentId])
  @@map("votes")
}


model Activity {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  tags        String[] @default([])
  videoUrl    String?
  routineItems ChildRoutineItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("activities")
}

model ChildRoutine {
  id        Int               @id @default(autoincrement())
  childId   Int               @map("child_id")
  parentId  Int               @map("parent_id")
  name      String            @default("Default")
  timezone  String            @default("Asia/Kolkata")
  isActive  Boolean           @default(true) @map("is_active")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  child     Child             @relation(fields: [childId], references: [id], onDelete: Cascade)
  parent    Parent            @relation(fields: [parentId], references: [id], onDelete: Cascade)
  items     ChildRoutineItem[]

  @@index([childId])
  @@index([parentId])
  @@map("child_routines")
}

model ChildRoutineItem {
  id          Int             @id @default(autoincrement())
  routineId   Int             @map("routine_id")
  dayOfWeek   DayOfWeek       @map("day_of_week")
  startMinute Int             @map("start_minute")
  endMinute   Int             @map("end_minute")
  title       String
  notes       String?
  order       Int             @default(0)
  isActive    Boolean         @default(true) @map("is_active")
  activityId  Int?            @map("activity_id")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  routine     ChildRoutine    @relation(fields: [routineId], references: [id], onDelete: Cascade)
  activity    Activity?       @relation(fields: [activityId], references: [id], onDelete: SetNull)
  checkIns    RoutineCheckIn[]

  @@index([routineId, dayOfWeek])
  @@index([activityId])
  @@map("child_routine_items")
}

model RoutineCheckIn {
  id        Int                @id @default(autoincrement())
  childId   Int                @map("child_id")
  itemId    Int                @map("item_id")
  date      DateTime           @map("date")
  status    RoutineCheckStatus
  note      String?
  createdAt DateTime           @default(now()) @map("created_at")

  child     Child              @relation(fields: [childId], references: [id], onDelete: Cascade)
  item      ChildRoutineItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([childId, itemId, date])
  @@index([childId, date])
  @@index([itemId])
  @@map("routine_checkins")
}
model AACCategory {
  id          Int      @id @default(autoincrement())
  title       String
  iconUrl    String?   @map("icon_url")
  isActive    Boolean  @default(true) @map("is_active")
  orderIndex  Int      @default(0) @map("order_index")

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  symbols     AACSymbol[]


  @@map("aac_categories")
}
model AACSymbol {
  id          Int      @id @default(autoincrement())
  title       String
  iconUrl     String?  @map("icon_url")
  isActive    Boolean  @default(true) @map("is_active")
  ttsText     String  @map("tts_text")
  orderIndex  Int      @default(0) @map("order_index")
  categoryId  Int?      @map("category_id")
  category    AACCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  isGlobalQuick Boolean @default(false) @map("is_global_quick")

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([categoryId])
  @@map("aac_symbols")

}





enum SupportedLanguage {
  ENGLISH
  HINDI
}

enum CommunicationStyle {
  SIMPLE
  DETAILED
  VISUAL_FIRST
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum DiagnosisTypes {
  AUTISM
  ADHD
  SPEECH_DELAY
  NOT_DIAGNOSED
}

enum DiagnosisStages {
  SUSPECTED
  CONFIRMED
  RECENTLY_DIAGNOSED
}

enum ChildDevelopmentStages {
  TODDLER
  EARLY_CHILDHOOD
  SCHOOL_AGE
}

enum ParentChildRelations {
  MOTHER
  FATHER
  CARETAKER
  BROTHER
  SISTER
  OTHERS
}

enum VoteType {
  UPVOTE
  DOWNVOTE
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum RoutineCheckStatus {
  DONE
  SKIPPED
  PARTIAL
}
