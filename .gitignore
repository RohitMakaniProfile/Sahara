# ----------------------
# Node & Package Managers
# ----------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.npm
.yarn-integrity
*.tgz

# ----------------------
# TypeScript & Build
# ----------------------
# Standard output directories for TS compilation
dist/
build/
# TypeScript cache
*.tsbuildinfo

# ----------------------
# Environment & Secrets
# ----------------------
# CRITICAL: Never commit environment variables
.env
.env.*
!.env.example

# Keys and Certificates
keys/*
certs/
*.pem
*.key
*.crt

# ----------------------
# Prisma & Database
# ----------------------
# Ignore the generated client if you output it to a custom path
/src/generated/prisma

# SQLite databases (if you use them for local dev testing)
*.db
*.sqlite
*.sqlite3

# ----------------------
# Editor & OS Files
# ----------------------
# macOS
.DS_Store

# Windows
Thumbs.db

# VS Code
# Ignore local history and user overrides, but allow shared settings
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# WebStorm / IntelliJ
.idea/

# ----------------------
# Testing & Coverage
# ----------------------
coverage/
.nyc_output/

# ----------------------
# Logs & Runtime
# ----------------------
logs
*.log
pids
*.pid
*.seed
*.pid.lock
